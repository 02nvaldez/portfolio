# ──────────────────────────────────────────────────────────────────────────────
# .env.example — Variables de entorno del portafolio Flask
# Copia este archivo como .env y rellena los valores reales.
# NUNCA subas el archivo .env al repositorio.
# ──────────────────────────────────────────────────────────────────────────────

# Clave secreta de Flask para firmar cookies y sesiones.
# Genera una segura con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esto-por-un-valor-secreto-aleatorio

# Google OAuth 2.0
# Obtén las credenciales en: https://console.cloud.google.com/apis/credentials
# URI de redirección autorizada LOCAL:  http://127.0.0.1:5000/login/google/callback
# URI de redirección autorizada PROD:   https://tudominio.com/login/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Correo de Gmail autorizado para acceder al panel de administración
ADMIN_ALLOWED_EMAIL=tu_email@gmail.com

# Contraseña inicial del usuario admin (solo se usa si la BD está vacía).
# En producción, define esto antes de iniciar la app por primera vez.
# Puedes cambiarla luego desde la BD directamente.
ADMIN_DEFAULT_PASSWORD=cambia-esta-contrasena-en-produccion

# ── Configuración de cookies de sesión (recomendado en producción) ─────────────
# Requiere HTTPS para que SESSION_COOKIE_SECURE funcione correctamente.
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax

# URL base del sitio en producción (para sitemap.xml y Open Graph).
# Sin barra al final. Ejemplo: https://tudominio.com
SITE_URL=https://tudominio.com
